# .env.example — Optional API Keys for 5 Real OSINT Skills (v1.7.0)
# All skills operate in 100% Free / Graceful Fallback mode when keys are absent.

# Tier 1 (Free / Optional Token)
IPINFO_TOKEN=           # optional: ipinfo.io token (free tier works without token for basic lookups)

# Tier 2 (Optional Paid Keys with automated fallback)
HIBP_API_KEY=           # optional: HaveIBeenPwned API v3 key (falls back to passive breach checks)
NUMVERIFY_KEY=          # optional: Numverify API key (falls back to carrier & HPLMN/VPLMN prefix analysis)

# Logging & Environment
LOG_LEVEL=INFO
