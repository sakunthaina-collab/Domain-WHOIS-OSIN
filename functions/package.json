{
  "name": "secops-command-center-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase (2nd Gen) — SecOps Cyber Defense Platform & Telemetry Backend",
  "author": "NAKARIN SAKULTHAI",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,hosting",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "peerDependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": ">=6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
